# Copy to backend/.env and fill in. All values have sane local defaults except
# the Google OAuth credentials, which you must create (see SETUP.md).

# --- Database ---
# Default is local SQLite (zero setup). For multi-user, use a Postgres URL, e.g. a free Neon instance:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/dbname?sslmode=require
DATABASE_URL=sqlite:///./recallai.db

# --- Auth ---
# Generate a strong one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start without a real SECRET_KEY. For local dev only, you can instead
# set ALLOW_INSECURE_SECRET_KEY=1 and skip SECRET_KEY — never do this in production.
SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=720

# --- Google OAuth (from Google Cloud Console → Credentials → OAuth client, type "Web") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Frontend origin (where users are sent after login) ---
FRONTEND_URL=http://localhost:3000

# --- CORS: comma-separated list of allowed origins (defaults to FRONTEND_URL if unset) ---
# ALLOWED_ORIGINS=http://localhost:3000

# --- Optional: LLM for the planner/coach agents (falls back to a deterministic mock if unset) ---
# ANTHROPIC_API_KEY=
# MODEL_NAME=claude-sonnet-5
# AGENT_DAILY_CALL_CAP=20

# --- Optional: error tracking (no-op if unset) ---
# SENTRY_DSN=
